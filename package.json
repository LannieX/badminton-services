{
  "name": "badminton-services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "migrate": "node --env-file-if-exists=.env src/migrate.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:worker": "wrangler dev",
    "build:worker": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "zod": "^4.1.0",
    "@neondatabase/serverless": "^1.2.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "wrangler": "^4.158.0"
  }
}
