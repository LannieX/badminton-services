{
  "name": "badminton-services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "migrate": "node --env-file-if-exists=.env src/migrate.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "pg": "^8.16.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
