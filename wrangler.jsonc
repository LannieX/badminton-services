{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ibadz-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://ibadz.vercel.app",
  },
  "observability": { "enabled": false },
}
